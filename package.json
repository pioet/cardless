{
  "name": "cardless",
  "version": "0.1.0",
  "description": "A TypeScript tabletop card-state server framework.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "cardless": "./src/cli.ts"
  },
  "scripts": {
    "cardless": "node src/cli.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "cookie": "^2.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cookie": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24"
  }
}
